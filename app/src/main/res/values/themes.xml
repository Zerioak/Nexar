<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/nexar_background</item>
        <item name="android:navigationBarColor">@color/nexar_background</item>
        <item name="android:windowBackground">@color/nexar_background</item>
    </style>

    <style name="Theme.Nexar.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexar_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_nexar_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexar</item>
    </style>
</resources>
